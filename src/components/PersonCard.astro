---
interface Props {
  name: string;
  title: string;
  institution: string;
  department?: string;
  country: string;
  email: string;
  role: "coordinator" | "steering" | "member";
  photo?: string;
  bio?: string;
}

const { name, title, institution, department, country, email, photo, bio } = Astro.props;

const initials = name
  .split(" ")
  .map((n) => n[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const dialogId = "bio-" + name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<!-- Card (entire card opens the profile modal) -->
<button type="button" data-bio-open={dialogId} class="group relative flex w-full cursor-pointer flex-col items-center pt-8 text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400 focus-visible:ring-offset-4 focus-visible:ring-offset-ground">
  <!-- Top accent rule — animates on hover -->
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-surface-raised"></div>
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-[2px] w-0 bg-violet-400 transition-[width] duration-700 ease-out group-hover:w-full"></div>

  <!-- Photo / Initials -->
  {photo ? (
    <img
      src={photo}
      alt={name}
      class="h-32 w-32 rounded-full object-cover object-top ring-2 ring-violet-800 transition-all duration-300 group-hover:ring-violet-400"
    />
  ) : (
    <div class="flex h-32 w-32 items-center justify-center rounded-full bg-surface ring-2 ring-violet-800 transition-all duration-300 group-hover:ring-violet-400">
      <span class="select-none font-display text-3xl font-semibold text-violet-400">{initials}</span>
    </div>
  )}

  <!-- Info block -->
  <div class="mt-5 space-y-1">
    <h3 class="font-display text-lg font-semibold leading-snug text-lav">{name}</h3>
    <p class="text-sm font-medium text-violet-400">{institution}</p>
    {department && <p class="text-xs font-body text-lav-400">{department}</p>}
  </div>

  <!-- Hover affordance -->
  <span class="mt-4 inline-flex items-center gap-1.5 font-body text-[10px] font-semibold uppercase tracking-label text-lav-500 transition-colors duration-300 group-hover:text-violet-300">
    {bio ? "View profile" : "Details"}
    <svg class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" />
    </svg>
  </span>
</button>

<!-- Profile modal -->
<dialog id={dialogId} class="bio-modal w-[min(92vw,40rem)] border border-line bg-surface p-0 text-left text-lav">
  <div class="relative max-h-[85vh] overflow-y-auto px-7 py-8 sm:px-10 sm:py-10">
    <!-- Close -->
    <button type="button" data-bio-close aria-label="Close" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center text-lav-400 transition-colors hover:text-lav focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header: photo + identity -->
    <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
      {photo ? (
        <img src={photo} alt={name} class="h-20 w-20 flex-shrink-0 rounded-full object-cover object-top ring-2 ring-violet-700" />
      ) : (
        <div class="flex h-20 w-20 flex-shrink-0 items-center justify-center rounded-full bg-ground ring-2 ring-violet-700">
          <span class="select-none font-display text-2xl font-semibold text-violet-400">{initials}</span>
        </div>
      )}
      <div class="min-w-0 pr-8">
        <h3 class="font-display text-2xl font-semibold leading-tight text-lav">{title} {name}</h3>
        <p class="mt-1 text-sm font-medium text-violet-400">{institution}</p>
        <p class="text-xs font-body text-lav-400">
          {[department, country].filter(Boolean).join(" · ")}
        </p>
      </div>
    </div>

    <div class="my-6 h-px w-full bg-gradient-to-r from-violet-500/60 via-line to-transparent"></div>

    <!-- Bio -->
    {bio ? (
      <p class="text-pretty font-body text-[15px] leading-[1.8] text-lav-300">{bio}</p>
    ) : (
      <p class="font-body text-sm italic leading-relaxed text-lav-400">Profile details coming soon.</p>
    )}

    <!-- Email -->
    <a
      href={`mailto:${email}`}
      class="mt-7 inline-flex items-center gap-2 border-t border-line pt-5 text-lav-500 transition-colors hover:text-violet-300"
      style="font-family: 'JetBrains Mono', monospace; font-size: 12px;"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      {email}
    </a>
  </div>
</dialog>

<script>
  function wireBioModals() {
    // Delegate open/close once.
    if (!(window as any).__bioModalWired) {
      (window as any).__bioModalWired = true;
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const opener = target.closest<HTMLElement>("[data-bio-open]");
        if (opener) {
          const dlg = document.getElementById(opener.getAttribute("data-bio-open")!) as HTMLDialogElement | null;
          dlg?.showModal?.();
          return;
        }
        if (target.closest("[data-bio-close]")) {
          target.closest("dialog")?.close();
        }
      });
    }
    // Backdrop click closes (guard each dialog once).
    document.querySelectorAll<HTMLDialogElement>("dialog.bio-modal").forEach((d) => {
      if (d.dataset.wired) return;
      d.dataset.wired = "1";
      d.addEventListener("click", (e) => {
        if (e.target === d) d.close();
      });
    });
  }

  wireBioModals();
  document.addEventListener("astro:after-swap", wireBioModals);
</script>
