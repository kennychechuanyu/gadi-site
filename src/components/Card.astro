---
interface Props {
  title: string;
  description: string;
  number?: string;
  href?: string;
  class?: string;
}

const { title, description, number, href, class: extraClass = "" } = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "group block border border-line bg-surface p-7 transition-all duration-200",
    href && "hover:border-violet-400 hover:shadow-sm cursor-pointer",
    extraClass,
  ]}
>
  {number && (
    <div class="mb-5 font-display text-4xl font-bold text-violet-400 leading-none">
      {number}
    </div>
  )}
  <slot name="icon" />
  <h3 class="font-display text-xl font-semibold text-lav group-hover:text-violet-300 transition-colors">
    {title}
  </h3>
  <p class="mt-3 text-sm font-body leading-relaxed text-lav-300">
    {description}
  </p>
  <slot />
</Tag>
