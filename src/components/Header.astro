---
import Navigation from "./Navigation.astro";
import MobileMenu from "./MobileMenu.astro";
import { siteConfig } from "../data/site-config";
---

<header class="sticky top-0 z-50 border-b border-line backdrop-blur-md" style="background-color: rgba(15, 18, 22, 0.82);">
  <div class="container-site">
    <div class="flex h-16 items-center justify-between">

      <!-- Logo -->
      <a href="/" class="flex items-center group" aria-label="GADI – Home">
        <img src="/images/gadi-logo.svg" alt="GADI" class="h-10 w-auto object-contain" />
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center">
        <Navigation items={siteConfig.nav} />
        <div class="ml-5 border-l border-line pl-5">
          <a
            href="/community"
            class="rounded-none border border-violet-500 px-4 py-1.5 text-xs font-body font-semibold uppercase tracking-label text-violet-400 hover:bg-violet-500 hover:text-ground transition-colors duration-200"
          >
            Join
          </a>
        </div>
      </div>

      <!-- Mobile menu -->
      <MobileMenu items={siteConfig.nav} />
    </div>
  </div>
</header>
