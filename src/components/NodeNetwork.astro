---
/**
 * NodeNetwork — an animated constellation of nodes and edges.
 * The visual signature of GADI: discrete domains (nodes) drifting and
 * forming connections (edges) — generalization made visible.
 *
 * Renders behind dark hero sections. Self-contained: DPR-aware, pointer
 * reactive, pauses when scrolled out of view, and disables under
 * prefers-reduced-motion (see global.css [data-net]).
 */
interface Props {
  class?: string;
}
const { class: extraClass = "" } = Astro.props;
---

<canvas
  data-net
  class:list={["pointer-events-none absolute inset-0 h-full w-full", extraClass]}
  aria-hidden="true"
></canvas>

<script>
  function initNodeNetwork() {
    const canvases = document.querySelectorAll<HTMLCanvasElement>("canvas[data-net]");
    if (!canvases.length) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    canvases.forEach((canvas) => {
      if (canvas.dataset.netInit === "1") return;
      canvas.dataset.netInit = "1";

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const parent = canvas.parentElement as HTMLElement;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      // Starfield palette — lavender stars on midnight indigo. No warm tones:
      // the pointer-driven "action" edges glow brighter lavender, not amber.
      const EDGE = "180, 171, 212";   // soft lavender lines
      const NODE = "200, 191, 234";   // star lavender
      const HUB  = "226, 221, 248";   // bright star (glowing)
      const ACT  = "224, 220, 250";   // brightest starlight — interaction

      let w = 0, h = 0;
      let nodes: { x: number; y: number; vx: number; vy: number; r: number; hub: boolean }[] = [];
      const pointer = { x: -9999, y: -9999, active: false };
      const LINK_DIST = 150;

      function resize() {
        w = parent.clientWidth;
        h = parent.clientHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // Density scales with area, capped for performance.
        const count = Math.min(64, Math.max(26, Math.round((w * h) / 22000)));
        nodes = Array.from({ length: count }, () => {
          const hub = Math.random() < 0.12;
          return {
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 0.22,
            vy: (Math.random() - 0.5) * 0.22,
            r: hub ? 2.6 + Math.random() * 1.4 : 1 + Math.random() * 1.3,
            hub,
          };
        });
      }

      function draw() {
        ctx.clearRect(0, 0, w, h);

        // Edges
        for (let i = 0; i < nodes.length; i++) {
          const a = nodes[i];
          for (let j = i + 1; j < nodes.length; j++) {
            const b = nodes[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const d = Math.hypot(dx, dy);
            if (d < LINK_DIST) {
              const o = (1 - d / LINK_DIST) * 0.5;
              ctx.strokeStyle = `rgba(${EDGE}, ${o})`;
              ctx.lineWidth = a.hub || b.hub ? 0.9 : 0.55;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }

          // Edge toward pointer — connections form around the cursor.
          if (pointer.active) {
            const dx = a.x - pointer.x;
            const dy = a.y - pointer.y;
            const d = Math.hypot(dx, dy);
            if (d < LINK_DIST * 1.5) {
              const o = (1 - d / (LINK_DIST * 1.5)) * 0.6;
              ctx.strokeStyle = `rgba(${ACT}, ${o})`;
              ctx.lineWidth = 0.7;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(pointer.x, pointer.y);
              ctx.stroke();
            }
          }
        }

        // Nodes
        for (const n of nodes) {
          const color = n.hub ? HUB : NODE;
          if (n.hub) {
            const g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.r * 4);
            g.addColorStop(0, `rgba(${color}, 0.5)`);
            g.addColorStop(1, `rgba(${color}, 0)`);
            ctx.fillStyle = g;
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r * 4, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.fillStyle = `rgba(${color}, ${n.hub ? 0.95 : 0.65})`;
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      function step() {
        for (const n of nodes) {
          n.x += n.vx;
          n.y += n.vy;
          if (n.x < -20) n.x = w + 20;
          if (n.x > w + 20) n.x = -20;
          if (n.y < -20) n.y = h + 20;
          if (n.y > h + 20) n.y = -20;

          // Gentle drift toward pointer for liveliness.
          if (pointer.active) {
            const dx = pointer.x - n.x;
            const dy = pointer.y - n.y;
            const d = Math.hypot(dx, dy);
            if (d < 120 && d > 0.1) {
              n.x += (dx / d) * 0.18;
              n.y += (dy / d) * 0.18;
            }
          }
        }
        draw();
      }

      let raf = 0;
      let running = false;
      function loop() { step(); raf = requestAnimationFrame(loop); }
      function start() { if (!running) { running = true; loop(); } }
      function stop() { running = false; cancelAnimationFrame(raf); }

      // Only animate while the hero is on screen.
      const io = new IntersectionObserver(
        ([e]) => (e.isIntersecting ? start() : stop()),
        { threshold: 0 }
      );
      io.observe(canvas);

      parent.addEventListener("pointermove", (e) => {
        const rect = canvas.getBoundingClientRect();
        pointer.x = e.clientX - rect.left;
        pointer.y = e.clientY - rect.top;
        pointer.active = true;
      });
      parent.addEventListener("pointerleave", () => (pointer.active = false));

      let rt: number;
      window.addEventListener("resize", () => {
        clearTimeout(rt);
        rt = window.setTimeout(resize, 150);
      });

      resize();
      draw();
    });
  }

  initNodeNetwork();
  document.addEventListener("astro:after-swap", initNodeNetwork);
</script>
