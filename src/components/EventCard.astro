---
import type { CollectionEntry } from "astro:content";
import { toInstants, wallClock, zoneName } from "../utils/eventTime";

interface Props {
  event: CollectionEntry<"events">;
}

const { event } = Astro.props;
const data = event.data;

const typeLabels: Record<string, string> = {
  conference: "Conference",
  workshop: "Workshop",
  hackathon: "Hackathon",
  "summer-school": "Summer School",
  "expert-meeting": "Expert Meeting",
  webinar: "Webinar",
  symposium: "Symposium",
};

const onDate = (opts: Intl.DateTimeFormatOptions, d = data.date) =>
  new Intl.DateTimeFormat("en-GB", { timeZone: "UTC", ...opts }).format(d);
const span = toInstants(data.time, data.date, data.timezone);
const time = span
  ? `${wallClock(span.start, data.timezone)}${span.end ? `–${wallClock(span.end, data.timezone)}` : ""} ${zoneName(span.start, data.timezone)}`
  : undefined;
const until = data.endDate ? `Until ${onDate({ day: "numeric", month: "long" }, data.endDate)}` : undefined;
const names = (data.speakers ?? []).map((s) => s.name);
const withLine = names.length > 0 ? `With ${new Intl.ListFormat("en-GB", { style: "long", type: "conjunction" }).format(names)}` : undefined;
---

<a
  href={`/events/${event.slug}`}
  class="group grid grid-cols-[4.25rem_minmax(0,1fr)] items-start gap-x-5 border-b border-line py-8 transition-colors duration-300 hover:bg-surface-raised/40 sm:grid-cols-[6rem_minmax(0,1fr)_auto] sm:gap-x-8 sm:px-3 lg:py-10"
>
  <div class="flex flex-col pt-1">
    <span class="font-display text-5xl font-semibold leading-[0.8] text-lav sm:text-6xl">{onDate({ day: "numeric" })}</span>
    <span class="label-caps mt-3 text-lav-300">{onDate({ month: "short" })} {onDate({ year: "numeric" })}</span>
  </div>

  <div class="min-w-0">
    <p class="label-caps text-violet-400">
      {[onDate({ weekday: "long" }), typeLabels[data.type], data.location].join(" · ")}
    </p>
    <h3 class="mt-3 text-balance font-display text-2xl font-semibold leading-tight text-lav transition-colors duration-300 group-hover:text-violet-300 sm:text-3xl">
      {data.title}
      {data.subtitle && <span class="block font-normal italic text-violet-400">{data.subtitle}</span>}
    </h3>
    {(time || until) && <p class="mt-4 font-body text-sm text-lav-200">{[until, time].filter(Boolean).join(" · ")}</p>}
    {withLine && <p class="mt-1.5 font-body text-sm text-lav-400">{withLine}</p>}
  </div>

  <span
    aria-hidden="true"
    class="hidden h-11 w-11 items-center justify-center self-center rounded-full border border-line text-lav-300 transition-all duration-300 group-hover:translate-x-1 group-hover:border-violet-400 group-hover:text-violet-300 sm:flex"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" />
    </svg>
  </span>
</a>
