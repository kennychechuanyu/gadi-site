    padding-left: 0.5rem;
  }
  @media (min-width: 768px) {
    .cell-body {
      padding-left: 1rem;
    }
  }
  .cell-len {
    display: none;
    text-align: right;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    line-height: 1.25rem;
    color: rgb(var(--c-lav-400));
  }
  @media (min-width: 768px) {
    .cell-len {
      display: block;
    }
  }

  .row-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-family: "Sora", system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.25rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .row--break .row-label {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .discussion {
    position: relative;
    margin-top: -1.1rem;
    border: 1px solid rgb(var(--c-violet-400) / 0.22);
    padding: 1.1rem 1.25rem 1.5rem;
    background:
      radial-gradient(ellipse 70% 120% at 0% 0%, rgb(var(--c-violet-400) / 0.08) 0%, transparent 60%),
      rgb(var(--c-surface) / 0.6);
  }
  @media (min-width: 768px) {
    .discussion {
      padding: 1.1rem 1.75rem 1.75rem;
    }
  }

  .now-badge {
    display: none;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid rgb(var(--c-violet-400) / 0.5);
    padding: 0 0.5rem;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--c-violet-300));
  }
  .row[data-now] .now-badge {
    display: inline-flex;
  }
  .row[data-now] .dot {
    background: rgb(var(--c-violet-300));
    border-color: rgb(var(--c-violet-300));
    box-shadow: 0 0 0 5px rgb(var(--c-violet-400) / 0.16), 0 0 22px rgb(var(--c-violet-400) / 0.6);
  }
  .row[data-done] {
    opacity: 0.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .status-chip :global(.pulse)::before,
    .hub-dot::after,
    .converge :global(.wire-flow) {
      animation: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-event]");

  if (root) {
    const tz = root.dataset.tz ?? "Europe/Brussels";
    const ymd = root.dataset.ymd ?? "";
    const start = new Date(root.dataset.start ?? "");
    const end = new Date(root.dataset.end ?? "");
    const local = Intl.DateTimeFormat().resolvedOptions().timeZone || tz;

    const ymdIn = (d: Date, zone: string) =>
      new Intl.DateTimeFormat("en-CA", { timeZone: zone, year: "numeric", month: "2-digit", day: "2-digit" }).format(d);
    const hm = (d: Date, zone: string) =>
      new Intl.DateTimeFormat("en-GB", { timeZone: zone, hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(d);
    const weekdayIn = (d: Date, zone: string) =>
      new Intl.DateTimeFormat("en-GB", { timeZone: zone, weekday: "short" }).format(d);
    const offsetIn = (d: Date, zone: string) =>
      new Intl.DateTimeFormat("en-GB", { timeZone: zone, timeZoneName: "shortOffset" })
        .formatToParts(d)
        .find((p) => p.type === "timeZoneName")?.value ?? zone;
    const shiftIn = (d: Date, zone: string) =>
      Math.round((Date.parse(ymdIn(d, zone)) - Date.parse(ymd)) / 86400000);

    const place = local.includes("/") ? local.split("/").pop()!.replace(/_/g, " ") : offsetIn(start, local);
    const differs = offsetIn(start, local) !== offsetIn(start, tz);

    const localSpan = root.querySelector<HTMLElement>("[data-local-span]");
    if (differs && localSpan && !Number.isNaN(start.getTime())) {
      const s0 = shiftIn(start, local);
      const s1 = shiftIn(end, local);
      const range =
        s0 === 0 && s1 === 0
          ? `${hm(start, local)}–${hm(end, local)}`
          : s0 === s1
            ? `${weekdayIn(start, local)} ${hm(start, local)}–${hm(end, local)}`
            : `${weekdayIn(start, local)} ${hm(start, local)} – ${weekdayIn(end, local)} ${hm(end, local)}`;
      localSpan.textContent = `${range}, ${place} time`;
      localSpan.classList.remove("hidden");
    }

    const zoneSwitch = root.querySelector<HTMLElement>("[data-zone-switch]");
    const zoneButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-zone]"));
    const stamps = Array.from(root.querySelectorAll<HTMLElement>("[data-t]"));

    const render = (mode: string) => {
      const zone = mode === "local" ? local : tz;
      stamps.forEach((el) => {
        const d = new Date(el.dataset.t ?? "");
        const shift = shiftIn(d, zone);
        el.textContent = hm(d, zone);
        if (shift !== 0) {
          const sup = document.createElement("sup");
          sup.className = "ml-0.5 text-[9px] text-lav-400";
          sup.textContent = shift > 0 ? `+${shift}` : `${shift}`;
          el.append(sup);
        }
      });
      zoneButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.zone === mode)));
      try {
        localStorage.setItem("gadi-time-zone", mode);
      } catch {}
    };

    if (differs && zoneSwitch) {
      const localButton = zoneButtons.find((b) => b.dataset.zone === "local");
      if (localButton) localButton.textContent = place;
      zoneSwitch.classList.add("is-shown");
      zoneButtons.forEach((b) => b.addEventListener("click", () => render(b.dataset.zone ?? "event")));
      let saved = "event";
      try {
        saved = localStorage.getItem("gadi-time-zone") ?? "event";
      } catch {}
      if (saved === "local") render("local");
    }

    const status = root.querySelector<HTMLElement>("[data-status]");
    const rowsEls = Array.from(root.querySelectorAll<HTMLElement>(".row[data-start], .seg[data-start]"));
    const glanceNow = root.querySelector<HTMLElement>("[data-glance-now]");

    const converge = root.querySelector<HTMLElement>("[data-converge]");
    const wires = converge?.querySelector("svg") ?? null;
    const hubDot = root.querySelector<HTMLElement>("[data-hub-dot]");
    const sources = Array.from(root.querySelectorAll<HTMLElement>("[data-source]"));

    const draw = () => {
      if (!converge || !wires || !hubDot) return;
      wires.replaceChildren();
      if (getComputedStyle(converge).display === "none") return;
      const box = converge.getBoundingClientRect();
      const hub = hubDot.getBoundingClientRect();
      const hx = hub.left + hub.width / 2 - box.left;
      const hy = hub.top + hub.height / 2 - box.top;
      const make = (tag: string, attrs: Record<string, string>) => {
        const el = document.createElementNS(wires.namespaceURI, tag);
        Object.entries(attrs).forEach(([k, v]) => el.setAttribute(k, v));
        return el;
      };
      sources.forEach((src, i) => {
        const r = src.getBoundingClientRect();
        const x = r.left + r.width / 2 - box.left;
        const y = r.bottom - box.top;
        const k = hy - y;
        const d = `M ${x.toFixed(1)} ${y.toFixed(1)} C ${x.toFixed(1)} ${(y + k * 0.55).toFixed(1)}, ${hx.toFixed(1)} ${(y + k * 0.35).toFixed(1)}, ${hx.toFixed(1)} ${hy.toFixed(1)}`;
        const tba = src.hasAttribute("data-tba");
        wires.append(
          make("path", { d, class: tba ? "wire wire--tba" : "wire", "data-i": String(i) }),
          make("path", {
            d,
            class: tba ? "wire-flow wire-flow--tba" : "wire-flow",
            "data-i": String(i),
            style: `animation-delay: ${(-i * 0.43).toFixed(2)}s`,
          }),
          make("circle", { cx: x.toFixed(1), cy: y.toFixed(1), r: "3", class: "wire-node" })
        );
      });
    };

    const setHot = (i: number | null) => {
      sources.forEach((s, j) => s.classList.toggle("is-hot", j === i));
      wires?.querySelectorAll("[data-i]").forEach((p) => {
        p.classList.toggle("is-hot", i !== null && p.getAttribute("data-i") === String(i));
      });
    };
    sources.forEach((s, i) => {
      s.addEventListener("mouseenter", () => setHot(i));
      s.addEventListener("mouseleave", () => setHot(null));
      s.addEventListener("focus", () => setHot(i));
      s.addEventListener("blur", () => setHot(null));
    });

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(draw);
    };
    window.addEventListener("resize", schedule);
    document.fonts?.ready.then(schedule);
    schedule();

    const tick = () => {
      const now = new Date();
      const phase = now >= end ? "past" : now >= start ? "live" : "upcoming";
      root.dataset.phase = phase;

      if (status) {
        status.replaceChildren();
        if (phase === "live") {
          const pulse = document.createElement("span");
          pulse.className = "pulse";
          status.append(pulse, "Live now");
        } else if (phase === "upcoming") {
          const days = Math.round((Date.parse(ymd) - Date.parse(ymdIn(now, tz))) / 86400000);
          status.append(days <= 0 ? "Today" : days === 1 ? "Tomorrow" : `In ${days} days`);
        }
        status.classList.toggle("is-shown", phase !== "past");
      }

      rowsEls.forEach((row) => {
        const s = new Date(row.dataset.start ?? "");
        const e = row.dataset.end ? new Date(row.dataset.end) : s;
        const live = phase === "live";
        row.toggleAttribute("data-now", live && now >= s && now < e);
        row.toggleAttribute("data-done", live && now >= e);
      });

      if (glanceNow) {
        const live = phase === "live";
        glanceNow.classList.toggle("is-shown", live);
        if (live) {
          const pct = ((now.getTime() - start.getTime()) / (end.getTime() - start.getTime())) * 100;
          glanceNow.style.left = `${Math.min(100, Math.max(0, pct)).toFixed(2)}%`;
        }
      }
    };

    tick();
    window.setInterval(tick, 60000);
  }

  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>("details[data-cal][open]").forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    document.querySelectorAll<HTMLDetailsElement>("details[data-cal][open]").forEach((d) => {
      d.open = false;
      d.querySelector("summary")?.focus();
    });
  });
</script>
