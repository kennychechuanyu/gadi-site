          </div>
        </div>
      </section>
    )}

    <section id="register" class="when-open section-pad scroll-mt-16 border-t border-line bg-surface">
      <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-7">
          <h2 class="label-caps mb-3 text-violet-400">Registration</h2>
          {data.registrationUrl ? (
            <>
              <p class="font-display text-3xl font-semibold leading-tight text-lav lg:text-4xl">Registration is open.</p>
              <div class="mt-8">
                <Button href={data.registrationUrl} variant="primary" size="lg" arrow>Register</Button>
              </div>
            </>
          ) : (
            <>
              <p class="font-display text-3xl font-semibold leading-tight text-lav lg:text-4xl">{data.registrationNote ?? "Registration details will follow."}</p>
              <p class="mt-4 max-w-lg font-body text-sm leading-relaxed text-lav-300">Leave your email address to hear when they are available.</p>
              <form action="https://formspree.io/f/mqewwreq" method="POST" class="mt-8 flex max-w-lg flex-col gap-3 sm:flex-row">
                <label for="notify-email" class="sr-only">Email address</label>
                <input id="notify-email" type="email" name="email" required autocomplete="email" placeholder="Your email address" class="input-field flex-1" />
                <input type="hidden" name="_subject" value={`Event updates: ${fullTitle}`} />
                <input type="hidden" name="event" value={fullTitle} />
                <button type="submit" class="whitespace-nowrap border border-violet-400 bg-violet-400 px-6 py-3 font-body text-xs font-semibold uppercase tracking-label text-ground transition-colors duration-200 hover:border-violet-300 hover:bg-violet-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface">
                  Notify me
                </button>
              </form>
            </>
          )}
        </div>

        <div class="lg:col-span-5">
          <h2 class="label-caps mb-3 text-violet-400">Questions</h2>
          <p class="font-body text-[15px] leading-relaxed text-lav-200">
            Write to the organisers at
            <a href={`mailto:${siteConfig.email}`} class="text-violet-400 underline decoration-violet-400/40 underline-offset-4 transition-colors hover:text-violet-300">{siteConfig.email}</a>.
          </p>
          {(googleUrl || icsUrl) && (
            <>
              <h2 class="label-caps mb-3 mt-10 text-violet-400">Add to calendar</h2>
              <p class="flex flex-wrap gap-x-6 gap-y-2 font-body text-[15px]">
                {googleUrl && (
                  <a href={googleUrl} target="_blank" rel="noopener noreferrer" class="text-lav-200 underline decoration-line underline-offset-4 transition-colors hover:text-violet-300 hover:decoration-violet-400/60">Google Calendar</a>
                )}
                {icsUrl && (
                  <a href={icsUrl} download class="text-lav-200 underline decoration-line underline-offset-4 transition-colors hover:text-violet-300 hover:decoration-violet-400/60">Apple Calendar, Outlook (.ics)</a>
                )}
              </p>
            </>
          )}
        </div>
      </div>
    </section>

    <div class="border-t border-line bg-ground">
      <div class="container-site py-8">
        <a href="/events" class="group inline-flex items-center gap-2.5 font-body text-xs font-semibold uppercase tracking-label text-lav-300 transition-colors hover:text-violet-300">
          <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H6m0 0 5.5 5.5M6 12l5.5-5.5" />
          </svg>
          All events
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

