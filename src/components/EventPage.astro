---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NodeNetwork from "./NodeNetwork.astro";
import Button from "./Button.astro";
import { siteConfig } from "../data/site-config";
import { toInstants, eventEnd, wallClock, zoneName } from "../utils/eventTime";

interface Props {
  event: CollectionEntry<"events">;
}

const { event } = Astro.props;
const { Content } = await event.render();
const data = event.data;
const hasBody = (event.body ?? "").trim().length > 0;

const typeLabels: Record<string, string> = {
  conference: "Conference",
  workshop: "Workshop",
  hackathon: "Hackathon",
  "summer-school": "Summer School",
  "expert-meeting": "Expert Meeting",
  webinar: "Webinar",
  symposium: "Symposium",
};
const typeLabel = typeLabels[data.type];
const online = /^online/i.test(data.location);
const eyebrow = online ? `Online ${typeLabel.toLowerCase()}` : typeLabel;
const fullTitle = data.subtitle ? `${data.title}: ${data.subtitle}` : data.title;

const tz = data.timezone;
const span = toInstants(data.time, data.date, tz);
const ends = eventEnd(data);
const starts = span ? new Date(span.start) : data.date;
const now = new Date();
const phase = now >= ends ? "past" : now >= starts ? "live" : "upcoming";

const onDate = (opts: Intl.DateTimeFormatOptions, d = data.date) =>
  new Intl.DateTimeFormat("en-GB", { timeZone: "UTC", ...opts }).format(d);
const day = onDate({ day: "numeric" });
const month = onDate({ month: "long" });
const year = onDate({ year: "numeric" });
const weekday = onDate({ weekday: "long" });
const ymd = data.date.toISOString().slice(0, 10);
const until = data.endDate ? onDate({ day: "numeric", month: "long", year: "numeric" }, data.endDate) : undefined;
const zone = span ? zoneName(span.start, tz) : "";
const timeText = span ? `${wallClock(span.start, tz)}${span.end ? `–${wallClock(span.end, tz)}` : ""}` : data.time;

const speakers = data.speakers ?? [];
let talkCount = 0;
const rows = (data.programme ?? []).map((row) => {
  const at = toInstants(row.time, data.date, tz);
  const minutes = at?.end ? Math.round((Date.parse(at.end) - Date.parse(at.start)) / 60000) : undefined;
  const n = row.kind === "talk" ? ++talkCount : undefined;
  const sp = row.speaker ? speakers.find((s) => s.name === row.speaker) : undefined;
  return { ...row, at, minutes, n, sp };
});
const talks = rows.filter((r) => r.kind === "talk");
const numberWords = ["No", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten"];
const talkSummary =
  talks.length > 0
    ? `${numberWords[talks.length] ?? talks.length} talks${rows.some((r) => r.kind === "discussion") ? ", then a discussion with all speakers" : ""}`
    : "";
const questionCount = data.questions?.length ?? 0;
const questionsHeading = `${numberWords[questionCount] ?? questionCount} questions for every talk`;
const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
const discussion = rows.find((r) => r.kind === "discussion");

const spanStart = span ? Date.parse(span.start) : 0;
const spanEnd = span?.end ? Date.parse(span.end) : 0;
const ticks: { iso: string; pct: number; edge: string }[] = [];
if (span?.end && spanEnd > spanStart) {
  for (let t = spanStart; t < spanEnd; t += 3600000) {
    ticks.push({
      iso: new Date(t).toISOString(),
      pct: ((t - spanStart) / (spanEnd - spanStart)) * 100,
      edge: t === spanStart ? "start" : "mid",
    });
  }
  ticks.push({ iso: span.end, pct: 100, edge: "end" });
}
const segTitle = (r: (typeof rows)[number]) => {
  const label = r.kind === "talk" ? `Talk ${r.n}: ${r.field}` : r.title ?? r.kind;
  return r.at?.end ? `${label}, ${wallClock(r.at.start, tz)}–${wallClock(r.at.end, tz)} ${zone}` : label;
};

const pageUrl = new URL(`/events/${event.slug}/`, Astro.site).href;
const stamp = (iso: string) => iso.replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
const googleUrl = span?.end
  ? "https://calendar.google.com/calendar/render?" +
    new URLSearchParams({
      action: "TEMPLATE",
      text: fullTitle,
      dates: stamp(span.start) + "/" + stamp(span.end),
      details: data.description + "\n\n" + pageUrl,
      location: data.location,
    }).toString()
  : undefined;
const icsUrl = span ? `/events/${event.slug}.ics` : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: fullTitle,
  description: data.description,
  startDate: span?.start ?? ymd,
  ...(span?.end ? { endDate: span.end } : {}),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: online
    ? "https://schema.org/OnlineEventAttendanceMode"
    : "https://schema.org/OfflineEventAttendanceMode",
  location: online ? { "@type": "VirtualLocation", url: pageUrl } : { "@type": "Place", name: data.location },
  organizer: { "@type": "Organization", name: siteConfig.fullName, url: siteConfig.url },
  ...(speakers.length > 0
    ? {
        performer: speakers.map((s) => ({
          "@type": "Person",
          name: s.name,
          affiliation: { "@type": "Organization", name: s.institution },
        })),
      }
    : {}),
  ...(data.ogImage ? { image: new URL(data.ogImage, Astro.site).href } : {}),
  url: pageUrl,
};
---

<BaseLayout title={fullTitle} description={data.description} image={data.ogImage} imageAlt={`${fullTitle}, ${eyebrow.toLowerCase()} on ${day} ${month} ${year}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <div
    data-event
    data-phase={phase}
    data-start={span?.start ?? data.date.toISOString()}
    data-end={ends.toISOString()}
    data-tz={tz}
    data-ymd={ymd}
  >
    <section
      class="band-dark relative isolate overflow-hidden border-b border-line"
      style="background: linear-gradient(160deg, rgb(var(--c-hero)) 0%, rgb(var(--c-ground)) 52%, rgb(var(--c-ground-deep)) 100%);"
    >
      <NodeNetwork class="opacity-80" />
      <div
        class="absolute inset-0 z-[2]"
        style="background:
          radial-gradient(ellipse 50% 65% at 84% 28%, rgb(var(--c-accent) / 0.10) 0%, transparent 62%),
          linear-gradient(to right, rgb(var(--c-ground) / 0.95) 0%, rgb(var(--c-ground) / 0.62) 55%, rgb(var(--c-ground) / 0.4) 100%);"
      ></div>
      <div class="absolute inset-x-0 top-0 z-[3] h-px bg-gradient-to-r from-transparent via-violet-400/60 to-transparent"></div>

      <div class="container-site relative z-10 pb-14 pt-8 lg:pb-16 lg:pt-10">
        <nav aria-label="Breadcrumb" class="mb-10 lg:mb-14">
          <ol class="flex items-center gap-2 font-body text-xs text-lav-400">
            <li><a href="/events" class="transition-colors hover:text-violet-300">Events</a></li>
            <li aria-hidden="true" class="text-lav-500">/</li>
            <li aria-current="page" class="text-lav-300">{typeLabel}</li>
          </ol>
        </nav>

        <div class="grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-10">
          <div class="lg:col-span-7 xl:col-span-8">
            <p class="label-caps mb-7 text-violet-300 fade-up">
              <span class="mr-2.5 inline-block h-1.5 w-1.5 -translate-y-0.5 rounded-full bg-violet-400 align-middle"></span>
              {eyebrow}
            </p>
            <h1 class="text-balance font-display text-[clamp(2.5rem,5.4vw,4.75rem)] font-bold leading-[1.02] tracking-[-0.01em] text-lav">
              <span class="mask-reveal block" style="--i:0;"><span>{data.title}</span></span>
              {data.subtitle && (
                <span class="mask-reveal mt-1 block text-[0.7em] leading-[1.12]" style="--i:1;">
                  <span><em class="font-normal italic text-violet-400">{data.subtitle}</em></span>
                </span>
              )}
            </h1>
            <div class="my-9 h-px w-28 bg-gradient-to-r from-violet-400 via-violet-400 to-transparent fade-up" style="transition-delay: 0.35s;"></div>
            <p class="max-w-2xl text-pretty font-body text-base leading-relaxed text-lav-300 lg:text-lg fade-up" style="transition-delay: 0.45s;">
              {data.deck ?? data.description}
            </p>
          </div>

          <aside class="lg:col-span-5 xl:col-span-4 fade-up" style="transition-delay: 0.55s;" aria-label="Date, time and place">
            <div class="relative border border-line bg-ground/85 backdrop-blur-sm">
              <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-violet-400/80 via-violet-400/20 to-transparent"></div>

              <div class="flex items-end justify-between gap-4 px-6 pb-6 pt-7 sm:px-7">
                <div class="flex items-end gap-4">
                  <span class="font-display text-[4.5rem] font-semibold leading-[0.78] text-lav">{day}</span>
                  <span class="pb-0.5">
                    <span class="label-caps block text-lav-200">{month} {year}</span>
                    <span class="label-caps mt-1.5 block text-lav-400">{until ? `to ${until}` : weekday}</span>
                  </span>
                </div>
                <span data-status class="status-chip"></span>
              </div>

              <dl class="border-t border-line">
                {timeText && (
                  <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-4 border-b border-line px-6 py-4 sm:px-7">
                    <dt class="label-caps pt-1 text-lav-400">Time</dt>
                    <dd>
                      <p class="font-body text-[15px] text-lav">
                        {span ? <time datetime={span.start}>{timeText}</time> : timeText} {zone}
                      </p>
                      <p data-local-span class="mt-1 hidden font-body text-[13px] text-lav-300"></p>
                      {data.provisional && <p class="when-open mt-1 font-body text-xs text-lav-400">Times are provisional</p>}
                    </dd>
                  </div>
                )}
                <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-4 px-6 py-4 sm:px-7">
                  <dt class="label-caps pt-1 text-lav-400">Where</dt>
                  <dd class="font-body text-[15px] text-lav">{data.location}</dd>
                </div>
              </dl>

              <div class="border-t border-line px-6 py-6 sm:px-7">
                <div class="when-open">
                  <div class="flex flex-wrap items-center gap-3">
                    {data.registrationUrl && (
                      <Button href={data.registrationUrl} variant="primary" arrow>Register</Button>
                    )}
                    {(googleUrl || icsUrl) && (
                      <details class="cal-menu relative" data-cal>
                        <summary class:list={["cal-trigger", data.registrationUrl ? "cal-trigger--quiet" : "cal-trigger--solid"]}>
                          Add to calendar
                          <svg class="cal-chevron h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                          </svg>
                        </summary>
                        <div class="absolute left-0 top-full z-30 mt-2 w-72 border border-line bg-surface p-1.5 shadow-[0_24px_48px_-20px_rgba(0,0,0,0.8)]">
                          {googleUrl && (
                            <a href={googleUrl} target="_blank" rel="noopener noreferrer" class="cal-item">
                              Google Calendar
                              <svg class="h-3.5 w-3.5 text-lav-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" />
                              </svg>
                            </a>
                          )}
                          {icsUrl && (
                            <a href={icsUrl} download class="cal-item">
                              Apple Calendar, Outlook
                              <span class="font-mono text-[10px] text-lav-400">.ics</span>
                            </a>
                          )}
                        </div>
                      </details>
                    )}
                  </div>
                  {!data.registrationUrl && data.registrationNote && (
                    <p class="mt-4 font-body text-[13px] leading-relaxed text-lav-300">
                      {data.registrationNote}
                      <a href="#register" class="ml-1 text-violet-400 underline decoration-violet-400/40 underline-offset-4 transition-colors hover:text-violet-300">Get notified</a>
                    </p>
                  )}
                </div>
                <p class="when-past font-display text-lg italic leading-snug text-lav-300">
                  This {typeLabel.toLowerCase()} took place on {day} {month} {year}.
                </p>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    {talks.length > 0 && (
      <section class="relative overflow-hidden border-b border-line bg-ground-deep" aria-labelledby="speakers-heading">
        <div class="speakers-glow" aria-hidden="true"></div>
        <div class="container-site relative pb-16 pt-14 lg:pb-24 lg:pt-16">
          <div class="mb-10 flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3 lg:mb-12">
            <h2 id="speakers-heading" class="label-caps text-violet-400">Speakers</h2>
            <p class="font-body text-sm text-lav-300">{talkSummary}.</p>
          </div>

          <ol class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6 lg:gap-4">
            {talks.map((t) => (
              <li>
                <a href={`#talk-${t.n}`} class="speaker" data-source data-tba={t.sp ? undefined : ""}>
                  <span class="speaker-no">{String(t.n).padStart(2, "0")}</span>
                  <span class:list={["speaker-avatar", !t.sp && "speaker-avatar--tba"]} aria-hidden="true">
                    {t.sp?.photo ? (
                      <img src={t.sp.photo} alt="" loading="lazy" decoding="async" />
                    ) : t.sp ? (
                      <span class="speaker-initials">{initialsOf(t.sp.name)}</span>
                    ) : (
                      <span class="speaker-tba-dot"></span>
                    )}
                  </span>
                  <span class="speaker-field">{t.short ?? t.field}</span>
                  {t.sp ? (
                    <>
                      <span class="speaker-name">{t.sp.name}</span>
                      <span class="speaker-inst">{t.sp.institution}</span>
                    </>
                  ) : (
                    <span class="speaker-name speaker-name--tba">To be announced</span>
                  )}
                </a>
              </li>
            ))}
          </ol>

          {discussion && (
            <>
              <div class="converge" data-converge aria-hidden="true">
                <svg data-converge-svg></svg>
              </div>
              <a href="#discussion" class="hub">
                <span class="hub-dot" data-hub-dot aria-hidden="true"></span>
                <span class="hub-kicker">{discussion.title ?? "Discussion"}</span>
                <span class="hub-title">{data.subtitle ?? discussion.title}</span>
              </a>
            </>
          )}
        </div>
      </section>
    )}

    {((data.about?.length ?? 0) > 0 || questionCount > 0) && (
      <section id="about" class="section-pad scroll-mt-16 bg-surface">
        <div class="container-site grid gap-16 lg:grid-cols-12 lg:gap-x-20">
          {data.about && data.about.length > 0 && (
            <div class="lg:col-span-7 fade-up">
              <h2 class="label-caps mb-8 text-violet-400">About</h2>
              <p class="text-pretty font-display text-[1.6rem] font-medium leading-[1.35] text-lav lg:text-[1.95rem]">{data.about[0]}</p>
              <div class="mt-8 space-y-5">
                {data.about.slice(1).map((para) => (
                  <p class="max-w-2xl text-pretty font-body text-base leading-[1.8] text-lav-200">{para}</p>
                ))}
              </div>
            </div>
          )}

          {data.questions && questionCount > 0 && (
            <div class="lg:col-span-5 fade-up" style="transition-delay: 0.12s;">
              <h2 class="label-caps mb-4 text-violet-400">{questionsHeading}</h2>
              {data.questionsIntro && (
                <p class="font-body text-sm leading-relaxed text-lav-300">{data.questionsIntro}</p>
              )}
              <ol class="mt-8 border-t border-line">
                {data.questions.map((q, i) => (
                  <li class="grid grid-cols-[3.5rem_minmax(0,1fr)] gap-x-4 border-b border-line py-6">
                    <span aria-hidden="true" class="numeral-outline select-none text-[2.75rem]">{String(i + 1).padStart(2, "0")}</span>
                    <div>
                      <h3 class="font-body text-[11px] font-semibold uppercase tracking-label text-lav-200">{q.label}</h3>
                      <p class="mt-2 text-pretty font-body text-[15px] leading-relaxed text-lav-300">{q.text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </section>
    )}

    {rows.length > 0 && (
      <section id="programme" class="section-pad scroll-mt-16 bg-ground">
        <div class="container-site">
          <div class="mb-12 flex flex-col gap-8 lg:mb-16 lg:flex-row lg:items-end lg:justify-between">
            <div class="fade-up">
              <h2 class="label-caps mb-3 text-violet-400">Programme</h2>
              <p class="font-display text-4xl font-semibold text-lav lg:text-5xl">{weekday} {day} {month}</p>
              {(data.format || data.provisional) && (
                <p class="mt-4 max-w-xl font-body text-sm leading-relaxed text-lav-300">
                  {[data.format, data.provisional && "Times are provisional."].filter(Boolean).join(" ")}
                </p>
              )}
            </div>
            <div data-zone-switch class="zone-switch">
              <span id="zone-label" class="label-caps text-lav-400">Show times in</span>
              <div role="group" aria-labelledby="zone-label" class="inline-flex border border-line bg-ground-deep p-1">
                <button type="button" data-zone="event" aria-pressed="true" class="zone-btn">{zone}</button>
                <button type="button" data-zone="local" aria-pressed="false" class="zone-btn">Your time</button>
              </div>
            </div>
          </div>

          {ticks.length > 0 && (
            <div class="glance" aria-hidden="true">
              <div class="glance-ticks">
                {ticks.map((t) => (
                  <span class:list={["glance-tick", `glance-tick--${t.edge}`]} style={`left: ${t.pct}%;`}>
                    <time datetime={t.iso} data-t={t.iso}>{wallClock(t.iso, tz)}</time>
                  </span>
                ))}
              </div>
              <div class="relative">
                <ol class="glance-bar">
                  {rows.map((r) => (
                    <li
                      class:list={["seg", `seg--${r.kind}`]}
                      style={`flex-grow: ${r.minutes ?? 1};`}
                      data-start={r.at?.start}
                      data-end={r.at?.end}
                      title={segTitle(r)}
                    >
                      {r.kind === "talk" ? (
                        <a href={`#talk-${r.n}`} class="seg-link" tabindex="-1">{r.n}</a>
                      ) : r.kind === "discussion" ? (
                        <a href="#discussion" class="seg-link seg-link--text" tabindex="-1">{r.title ?? "Discussion"}</a>
                      ) : null}
                    </li>
                  ))}
                </ol>
                <span class="glance-now" data-glance-now></span>
              </div>
            </div>
          )}

          <ol class="programme">
            {rows.map((r) => (
              <li
                id={r.n ? `talk-${r.n}` : r.kind === "discussion" ? "discussion" : undefined}
                class:list={["row scroll-mt-24", `row--${r.kind}`]}
                data-start={r.at?.start}
                data-end={r.at?.end}
              >
                <div class="cell-time">
                  {r.at && (
                    <time datetime={r.at.start} data-t={r.at.start} class="block font-mono text-sm leading-5 tabular-nums text-lav-100">
                      {wallClock(r.at.start, tz)}
                    </time>
                  )}
                  {r.at?.end && r.kind !== "break" && (
                    <time datetime={r.at.end} data-t={r.at.end} class="block font-mono text-xs leading-5 tabular-nums text-lav-400">
                      {wallClock(r.at.end, tz)}
                    </time>
                  )}
                </div>

                <div class="rail" aria-hidden="true"><span class="dot"></span></div>

                <div class="cell-body">
                  {r.kind === "talk" && (
                    <>
                      <p class="row-label text-violet-400">
                        Talk {r.n}
                        {r.minutes && <span class="text-lav-400 md:hidden">· {r.minutes} min</span>}
                        <span class="now-badge">Now</span>
                      </p>
                      <h3 class="mt-1.5 text-pretty font-display text-[1.6rem] font-semibold leading-[1.2] text-lav md:text-[1.85rem]">
                        {r.title ?? r.field}
                      </h3>
                      {r.title && r.field && <p class="mt-1 font-body text-xs text-lav-400">{r.field}</p>}
                      {r.text && <p class="mt-3 max-w-2xl text-pretty font-body text-[15px] leading-relaxed text-lav-300">{r.text}</p>}
                      <div class:list={["mt-5 flex gap-4", r.sp?.bio ? "items-start" : "items-center"]}>
                        <span class:list={["avatar-sm", r.sp?.bio && "avatar-sm--lg", !r.sp && "avatar-sm--tba"]} aria-hidden="true">
                          {r.sp?.photo ? <img src={r.sp.photo} alt="" loading="lazy" decoding="async" /> : r.sp ? initialsOf(r.sp.name) : null}
                        </span>
                        <div class="min-w-0">
                        <p class:list={["font-body text-sm", r.sp?.bio && "pt-1"]}>
                          {r.sp ? (
                            <>
                              {r.sp.website ? (
                                <a href={r.sp.website} target="_blank" rel="noopener noreferrer" class="font-semibold text-lav underline decoration-line underline-offset-4 transition-colors hover:text-violet-300 hover:decoration-violet-400/60">{r.sp.name}</a>
                              ) : (
                                <span class="font-semibold text-lav">{r.sp.name}</span>
                              )}
                              <span class="text-lav-300">, {r.sp.institution}</span>
                            </>
                          ) : (
                            <span class="italic text-lav-400">Speaker to be announced</span>
                          )}
                        </p>
                        {r.sp?.bio && <p class="mt-2 max-w-2xl text-pretty font-body text-sm leading-relaxed text-lav-300">{r.sp.bio}</p>}
                        {r.sp?.photoCredit && <p class="mt-2 font-body text-[11px] text-lav-400">Photo: {r.sp.photoCredit}</p>}
                        </div>
                      </div>
                    </>
                  )}

                  {r.kind === "discussion" && (
                    <div class="discussion">
                      <p class="row-label text-violet-400">
                        {r.with ? `With ${r.with.toLowerCase()}` : "Discussion"}
                        {r.minutes && <span class="text-lav-400 md:hidden">· {r.minutes} min</span>}
                        <span class="now-badge">Now</span>
                      </p>
                      <h3 class="mt-1.5 font-display text-[1.85rem] font-semibold leading-tight text-lav md:text-[2.1rem]">{r.title ?? "Discussion"}</h3>
                      {r.text && <p class="mt-3 max-w-2xl text-pretty font-body text-[15px] leading-relaxed text-lav-300">{r.text}</p>}
                    </div>
                  )}

                  {(r.kind === "welcome" || r.kind === "closing") && (
                    <>
                      <p class="row-label text-lav-200">
                        {r.title}
                        {r.minutes && <span class="text-lav-400 md:hidden">· {r.minutes} min</span>}
                        <span class="now-badge">Now</span>
                      </p>
                      {r.text && <p class="mt-1.5 max-w-2xl text-pretty font-body text-[15px] leading-relaxed text-lav-300">{r.text}</p>}
                    </>
                  )}

                  {r.kind === "break" && (
                    <p class="row-label font-medium normal-case tracking-normal text-lav-400">
                      {r.title ?? "Break"}
                      {r.minutes && <span class="md:hidden">· {r.minutes} min</span>}
                      <span class="now-badge">Now</span>
                    </p>
                  )}
                </div>

                <div class="cell-len">{r.minutes && `${r.minutes} min`}</div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {hasBody && (
      <section class="section-pad border-t border-line bg-surface">
        <div class="container-narrow">
          <div class="prose max-w-none font-body prose-headings:font-display prose-headings:font-semibold prose-headings:text-lav prose-p:leading-relaxed prose-p:text-lav-200 prose-a:text-violet-400 prose-strong:text-lav prose-li:text-lav-200 prose-li:marker:text-violet-400">
