---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/Section.astro";
import FormHandler from "../components/FormHandler.astro";
import { siteConfig } from "../data/site-config";
import { formAction } from "../utils/forms";

const CONTACT_FORM = formAction("mjgjjngk");
---

<PageLayout
  title="Contact | GADI"
  description="Get in touch with the GADI coordination team at Hasselt University."
  pageTitle="Contact"
  pageSubtitle="Get in touch"
>
  <Section background="white">
    <div class="grid gap-12 lg:grid-cols-[1fr,20rem] fade-up">
      <div>
        <p class="text-base font-body leading-relaxed text-lav-200 mb-8">
          For enquiries about membership, events, or collaborations, use the form below and the
          coordination team will get back to you.
        </p>
        <div class="border border-line bg-surface p-7">
          <form action={CONTACT_FORM} method="POST" class="space-y-4" data-site-form="contact" data-success="contact-success">
            <input type="hidden" name="form" value="contact" />
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="label-caps mb-1.5 block text-lav-400" for="name">Name</label>
                <input id="name" name="name" type="text" required class="input-field" placeholder="Your name" />
              </div>
              <div>
                <label class="label-caps mb-1.5 block text-lav-400" for="contact-email">Email</label>
                <input id="contact-email" name="email" type="email" required class="input-field" placeholder="you@university.edu" />
              </div>
            </div>
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="subject">Subject</label>
              <select id="subject" name="subject" class="input-field">
                <option value="" disabled selected>Select a subject</option>
                <option value="Network membership">Network membership</option>
                <option value="Events and programs">Events and programs</option>
                <option value="Research collaboration">Research collaboration</option>
                <option value="Media and communication">Media and communication</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="message">Message</label>
              <textarea id="message" name="message" rows={6} required class="textarea-field" placeholder="How can we help?"></textarea>
            </div>
            <button type="submit" class="w-full border border-violet-500 bg-violet-500 px-6 py-3 text-xs font-body font-semibold uppercase tracking-label text-ground hover:bg-violet-400 transition-colors">
              Send Message
            </button>
          </form>
          <div id="contact-success" class="hidden" role="status">
            <p class="font-display text-2xl font-semibold text-lav">Thank you. Your message has been sent.</p>
            <p class="mt-3 text-sm font-body leading-relaxed text-lav-300">
              We reply from {siteConfig.email}, usually within a few days.
            </p>
          </div>
        </div>
      </div>

      <aside class="lg:pt-14">
        <div class="border border-line bg-surface p-6">
          <div>
            <p class="label-caps mb-2 text-lav-400">Email</p>
            <a href={`mailto:${siteConfig.email}`} class="text-sm font-body text-violet-400 hover:text-violet-300 transition-colors break-all">
              {siteConfig.email}
            </a>
          </div>
        </div>
      </aside>
    </div>
  </Section>
</PageLayout>

<FormHandler />
