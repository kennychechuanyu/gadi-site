---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import FormHandler from "../components/FormHandler.astro";
import { siteConfig } from "../data/site-config";
import { formAction } from "../utils/forms";

const UPDATES_FORM = formAction("mqewwreq");
const MEMBERSHIP_FORM = formAction("mqewwreq");
const DISCUSSION_FORM = formAction("mlgaaqgn");
const positions = ["PhD Student", "Postdoctoral Researcher", "Assistant Professor", "Associate Professor", "Full Professor", "Other"];
---

<PageLayout
  title="Community | GADI"
  description="Join the Generalization Across Domains Initiative. Become a member, propose research topics, and connect with researchers across disciplines."
  pageTitle="Community"
  pageSubtitle="Join the network"
>
  <Section background="white">
    <div class="mx-auto max-w-2xl text-center fade-up">
      <p class="label-caps mb-3 text-violet-400">Quick Signup</p>
      <h2 class="font-display text-3xl font-semibold text-lav">
        Just want to receive updates?
      </h2>
      <p class="mt-3 text-sm font-body text-lav-300 leading-relaxed">
        Enter your email to stay informed about events and opportunities. No full application needed.
      </p>
      <form action={UPDATES_FORM} method="POST" class="mt-6 flex flex-col sm:flex-row gap-3 max-w-lg mx-auto" data-site-form="updates" data-success="updates-success">
        <input type="hidden" name="form" value="updates" />
        <input type="hidden" name="_subject" value="GADI Updates Signup" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          aria-label="Email address"
          placeholder="Your email address"
          class="input-field flex-1 text-center sm:text-left"
        />
        <button type="submit" class="px-6 py-3 border border-violet-500 bg-violet-500 text-xs font-body font-semibold uppercase tracking-label text-ground hover:bg-violet-400 hover:border-violet-400 transition-colors whitespace-nowrap">
          Subscribe
        </button>
      </form>
      <div id="updates-success" class="hidden mt-6" role="status">
        <p class="font-display text-2xl font-semibold text-lav">Thank you, you are on the list.</p>
        <p class="mt-2 text-sm font-body text-lav-300">We will email you about GADI's events and opportunities.</p>
      </div>
    </div>
  </Section>

  <Section background="cream">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <div class="fade-up">
        <p class="label-caps mb-3 text-violet-400">Open Membership</p>
        <h2 class="font-display text-4xl font-semibold text-lav">
          GADI is open to all researchers
        </h2>
        <div class="mt-5 h-px w-12 bg-gradient-to-r from-violet-400 to-transparent" />
        <p class="mt-6 text-base font-body leading-relaxed text-lav-200">
          Membership in GADI is free and open to anyone with a genuine interest in generalization and
          transfer of learning across disciplines. There is no affiliation requirement.
        </p>
        <p class="mt-4 text-base font-body leading-relaxed text-lav-200">
          We welcome researchers at all career stages, from doctoral students to full professors,
          from psychology, neuroscience, artificial intelligence, education, linguistics, psychiatry,
          cognitive science, and related fields.
        </p>

        <div class="mt-8 space-y-4">
          {[
            { label: "Access", desc: "Receive announcements, event invitations, and network updates." },
            { label: "Participate", desc: "Join working groups, attend conferences, workshops, and hackathons." },
            { label: "Collaborate", desc: "Connect with researchers across disciplines for joint projects." },
            { label: "Develop", desc: "Apply for travel support and participate in future summer schools and training events." },
          ].map((item) => (
            <div class="flex gap-3">
              <div class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-violet-400" />
              <p class="text-base font-body text-lav-200">
                <strong class="font-semibold text-lav">{item.label}.</strong> {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="fade-up" style="transition-delay: 0.1s;">
        <div class="border border-line bg-surface p-7">
          <h3 class="font-display text-2xl font-semibold text-lav mb-6">
            Membership form
          </h3>
          <form action={MEMBERSHIP_FORM} method="POST" class="space-y-4" data-site-form="join" data-success="join-success">
            <input type="hidden" name="form" value="join" />
            <input type="hidden" name="_subject" value="New GADI Membership Request" />
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="label-caps mb-1.5 block text-lav-400" for="first-name">First Name</label>
                <input id="first-name" name="first_name" type="text" required class="input-field" />
              </div>
              <div>
                <label class="label-caps mb-1.5 block text-lav-400" for="last-name">Last Name</label>
                <input id="last-name" name="last_name" type="text" required class="input-field" />
              </div>
            </div>
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="email">Email</label>
              <input id="email" name="email" type="email" required class="input-field" />
            </div>
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="institution">Institution</label>
              <input id="institution" name="institution" type="text" class="input-field" />
            </div>
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="position">Position</label>
              <select id="position" name="position" required class="input-field">
                <option value="" disabled selected>Select position</option>
                {positions.map((p) => <option value={p}>{p}</option>)}
              </select>
            </div>
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="field">Primary Research Field</label>
              <input id="field" name="research_field" type="text" class="input-field" placeholder="e.g. Cognitive psychology, Machine learning" />
            </div>
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="interest">Why are you interested in GADI?</label>
              <textarea id="interest" name="interest" rows={3} class="textarea-field" placeholder="Briefly describe your interest in generalization research and what you hope to contribute or gain from the network."></textarea>
            </div>
            <label class="flex items-start gap-3 text-sm font-body text-lav-200" for="list-consent">
              <input id="list-consent" name="list_on_website" type="checkbox" value="yes" class="mt-1 h-4 w-4 shrink-0 accent-violet-500" />
              <span>I agree to have my name, position, and institution listed on the GADI website.</span>
            </label>
            <p class="text-xs font-body leading-relaxed text-lav-400">
              Your details go to the GADI coordination team and are used only to manage your membership.
              You are listed on the website only if you tick the box above. To see, change, or remove your
              details, email <a href={`mailto:${siteConfig.email}`} class="text-violet-400 hover:underline">{siteConfig.email}</a>.
              Fields marked <span class="text-violet-400">*</span> are required.
            </p>
            <button type="submit" class="w-full border border-violet-500 bg-violet-500 px-6 py-3 text-xs font-body font-semibold uppercase tracking-label text-ground hover:bg-violet-400 hover:border-violet-400 transition-colors">
              Submit Application
            </button>
          </form>
          <div id="join-success" class="hidden" role="status">
            <p class="font-display text-2xl font-semibold text-lav">Thank you for joining.</p>
            <p class="mt-3 text-sm font-body leading-relaxed text-lav-300">
              Your membership request has been sent to the GADI coordination team. We will be in touch by email.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section label="Scientific Discussions" title="Propose a topic" background="cream">
    <div class="grid gap-12 lg:grid-cols-2 items-start">
      <div class="fade-up">
        <p class="text-base font-body leading-relaxed text-lav-200">
          GADI working groups are built around member-proposed research topics. If you have a question,
          methodology, or theme you would like to see discussed across disciplines, submit it here.
          Topics that attract sufficient interest will be developed into working group activities.
        </p>
        <p class="mt-4 text-base font-body leading-relaxed text-lav-200">
          Examples of relevant topics include: measurement standards for generalization paradigms,
          cross-species experimental designs, computational benchmarks for transfer learning, or
          educational interventions promoting robust generalization.
        </p>
      </div>

      <div class="fade-up" style="transition-delay: 0.1s;">
        <div class="border border-line bg-surface p-6">
          <form action={DISCUSSION_FORM} method="POST" class="space-y-4" data-site-form="topic" data-success="topic-success">
            <input type="hidden" name="form" value="topic" />
            <input type="hidden" name="_subject" value="New GADI Discussion Topic" />
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="topic-title">Topic Title</label>
              <input id="topic-title" name="topic_title" type="text" required class="input-field" placeholder="Brief, descriptive title" />
            </div>
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="topic-desc">Description</label>
              <textarea id="topic-desc" name="topic_description" rows={4} required class="textarea-field" placeholder="Describe the research question or topic, and why it is relevant across disciplines."></textarea>
            </div>
            <div>
              <label class="label-caps mb-1.5 block text-lav-400" for="topic-email">Your Email</label>
              <input id="topic-email" name="email" type="email" required class="input-field" placeholder="you@university.edu" />
            </div>
            <button type="submit" class="w-full border border-violet-500 bg-violet-500 px-6 py-3 text-xs font-body font-semibold uppercase tracking-label text-ground hover:bg-violet-400 hover:border-violet-400 transition-colors">
              Propose Topic
            </button>
          </form>
          <div id="topic-success" class="hidden" role="status">
            <p class="font-display text-2xl font-semibold text-lav">Thank you for the topic.</p>
            <p class="mt-3 text-sm font-body leading-relaxed text-lav-300">
              It has been sent to the GADI coordination team. We will be in touch by email.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>
</PageLayout>

<FormHandler />
